# Build-time API base URL (never hard-code it). One build works against localhost, the field kit and the cloud.
VITE_API_URL=http://localhost:8000
# Raster tile URL template; leave unset for OpenStreetMap (dev only). The field kit uses a local PMTiles extract.
# VITE_TILE_URL=
# Dev server only (ignored by production builds): pre-fill the API key so you are not asked each reload.
# VITE_DEV_API_KEY=
