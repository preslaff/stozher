# Build-time API base URL (never hard-code it). One build works against localhost, the field kit and the cloud.
VITE_API_URL=http://localhost:8000
# Base map: by default a local PMTiles file at <base>/basemap/bulgaria.pmtiles, built by tools/basemap/fetch.sh (works offline).
# VITE_BASEMAP_URL=            # absolute URL of another PMTiles file (for example one served by the field kit)
# VITE_TILE_URL=               # online raster template (development only); wins over the file when set
# Dev server only (ignored by production builds): pre-fill the API key so you are not asked each reload.
# VITE_DEV_API_KEY=
