# Copy to infra/.env (never commit). Secrets only through environment variables.
# Local PostgreSQL 16 (not a container); needs the postgis and vector extensions.
# Unix-socket peer auth as your own role; or use postgresql+asyncpg://user:pass@localhost:5432/stozher
DATABASE_URL=postgresql+asyncpg://preslaff@/stozher?host=/var/run/postgresql
# 32 random bytes as hex (openssl rand -hex 32); encrypts node master keys at rest
STOZHER_KEK=

# First admin API key, created on first start if no admin key exists
STOZHER_BOOTSTRAP_ADMIN_KEY=

# Dashboard build-time API base URL (web/dashboard/.env)
VITE_API_URL=http://localhost:8000
# Ed25519 seed that signs acknowledgements (python -m stozher_api.cli gen-signing-key); absent = acks off
STOZHER_ED25519_SEED=

# Field kit only: sync witness records with the cloud (docs/api.md section 8). Leave empty for no sync.
STOZHER_CLOUD_URL=
STOZHER_CLOUD_KEY=
