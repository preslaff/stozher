# Copy to infra/.env (never commit). Secrets only through environment variables.
POSTGRES_USER=stozher
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stozher
DATABASE_URL=postgresql+asyncpg://stozher:change-me@db:5432/stozher

# First admin API key, created on first start if no admin key exists
STOZHER_BOOTSTRAP_ADMIN_KEY=

# Dashboard build-time API base URL (web/dashboard/.env)
VITE_API_URL=http://localhost:8000
