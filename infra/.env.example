# Copy to infra/.env (never commit). Secrets only through environment variables.
# Local PostgreSQL 16 (not a container); needs the postgis and vector extensions.
# Unix-socket peer auth as your own role; or use postgresql+asyncpg://user:pass@localhost:5432/stozher
DATABASE_URL=postgresql+asyncpg://preslaff@/stozher?host=/var/run/postgresql
# 32 random bytes as hex (openssl rand -hex 32); encrypts node master keys at rest
STOZHER_KEK=

# First admin API key, created on first start if no admin key exists
STOZHER_BOOTSTRAP_ADMIN_KEY=

# Dashboard build-time API base URL (web/dashboard/.env)
VITE_API_URL=http://localhost:8000
# Ed25519 seed that signs acknowledgements (python -m stozher_api.cli gen-signing-key); absent = acks off
STOZHER_ED25519_SEED=

# Field kit only: sync witness records with the cloud (docs/api.md section 8). Leave empty for no sync.
STOZHER_CLOUD_URL=
STOZHER_CLOUD_KEY=

# Optional assistant (docs/assistant.md). Off unless the kit is started with ASSISTANT=on.
# The API forwards questions to this address (loopback). Empty: the assistant is absent.
STOZHER_ASSISTANT_URL=
# auto = the cloud model when switched on and reachable, else the local one; local / cloud force one.
STOZHER_ASSISTANT_ENGINE=auto
# Local engine (works offline): llama.cpp `llama-server --jinja -m <model.gguf> --port 8080` (default) or Ollama.
STOZHER_ASSISTANT_LOCAL_BACKEND=llamacpp
STOZHER_LLAMACPP_URL=http://127.0.0.1:8080
# Model name: empty = what llama-server loaded; for Ollama e.g. qwen2.5:7b-instruct (the default there).
STOZHER_ASSISTANT_LOCAL_MODEL=
# Cloud engine: used only when BOTH are set. Situation summaries then leave this machine; default is off.
STOZHER_ASSISTANT_CLOUD=off
ANTHROPIC_API_KEY=
